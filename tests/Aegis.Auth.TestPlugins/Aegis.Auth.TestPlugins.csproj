<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugins built only against the public API of Aegis.Auth and Aegis.Auth.Http, like a separately shipped
    plugin package (e.g. Aegis.Auth.Organizations). Aegis.Auth has no InternalsVisibleTo for this assembly,
    so if a plugin here needs something internal, the plugin contract is missing a public member.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aegis.Auth\Aegis.Auth.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Auth.Http\Aegis.Auth.Http.csproj" />
  </ItemGroup>

</Project>
